@page
@model SwagLabs.Web.Pages.Auth.LoginModel
@{
	ViewData["Title"] = "Login";
	Layout = "../Shared/_LoginLayout.cshtml";
}

<div class="text-center mt-5">
	<h2 class="fw-light">Swag&nbsp;&nbsp;Labs</h2>
</div>
<div class="bg-white container mt-5 p-3">
	<form asp-page="Login">
		<div class="d-flex justify-content-center">
			<div class="col-md-4">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				@if (!string.IsNullOrEmpty(Model.Error))
				{
					<div class="alert alert-danger" role="alert">@Model.Error</div>
				}
				<div>
					<input asp-for="@Model.LoginViewModel.UserName" class="form-control borderless" placeholder="Username" />
					<span asp-validation-for="@Model.LoginViewModel.UserName" class="text-danger"></span>
				</div>
				<div>
					<input asp-for="@Model.LoginViewModel.Password" class="form-control borderless" placeholder="Password" />
					<span asp-validation-for="@Model.LoginViewModel.Password" class="text-danger"></span>
				</div>
				<div class="mt-3">
					<button type="submit" class="btn btn-success w-100">
						Login
					</button>
				</div>
			</div>
		</div>
	</form>
</div>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}